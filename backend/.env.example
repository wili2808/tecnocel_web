# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================================
DB_NAME=db_tecnocel_v4
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# CONFIGURACIÓN JWT
# ===========================================
# IMPORTANTE: Genera una clave única y segura para producción
# Ejemplo: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=clave_secreta_supersegura_cambiar_en_produccion

# ===========================================
# CONFIGURACIÓN DE LOGGING
# ===========================================
# Niveles: error, warn, info, debug
LOG_LEVEL=info
# true = muestra queries SQL en consola
SEQUELIZE_DEBUG=false

# ===========================================
# CONFIGURACIÓN DE IMÁGENES
# ===========================================
IMAGES_BASE_PATH=C:\Users\WiLi\Desktop\tecnocel_web\backend\uploads
PRODUCT_IMAGES_PATH=C:\Users\WiLi\Desktop\tecnocel_web\backend\uploads\productos
COMMENT_IMAGES_PATH=C:\Users\WiLi\Desktop\tecnocel_web\backend\uploads\comentarios
BASE_URL=http://localhost
IMAGES_ENDPOINT=
DEFAULT_PRODUCT_IMAGE=default-product.png
DEFAULT_COMMENT_IMAGE=default-comment.png
# macOS/Linux
# IMAGES_BASE_PATH=/var/www/html/tecnocel
# PRODUCT_IMAGES_PATH=/var/www/html/tecnocel/almacen/img_productos
# COMMENT_IMAGES_PATH=/var/www/html/tecnocel/img_comments
# ===========================================
# CLOUDINARY (opcional - recomendado en producción)
# ===========================================
# true = sube y sirve imágenes desde Cloudinary
# false = usa filesystem local
USE_CLOUDINARY=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=tecnocel/productos
CLOUDINARY_COMMENT_FOLDER=tecnocel/comentarios

# ===========================================
# CONFIGURACIÓN DE EMAIL
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion
EMAIL_FROM=tu_email@gmail.com

# ===========================================
# CONFIGURACIÓN DEL FRONTEND
# ===========================================
FRONTEND_URL=http://localhost:5173

# ===========================================
# CONFIGURACIÓN DE GOOGLE OAUTH
# ===========================================
# Obtener en: https://console.cloud.google.com/apis/credentials
DB_SSL=true
DB_SSL_CA_PATH=./ca-certificate.pem
# Alternativa en plataformas cloud (sin archivo): pegar el contenido PEM completo
# DB_SSL_CA_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----

GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret


