# ============================================================
# TECNOCEL WEB — CONFIGURACIÓN DE ENTORNO
# ============================================================
#
# Copiá este archivo como .env y completá los valores:
#   cp .env.example .env
#
# MODOS DISPONIBLES:
#
#   local        → BD XAMPP + imágenes en /uploads  (USE_CLOUDINARY=false)
#   local-cloud  → BD XAMPP + imágenes en Cloudinary (USE_CLOUDINARY=true)
#   aiven        → BD Aiven + imágenes en Cloudinary (USE_CLOUDINARY=true)
#
# Para cambiar de modo editá las 2 secciones marcadas con [CAMBIAR]
# ============================================================


# ============================================================
# [CAMBIAR 1/2] BASE DE DATOS
# ============================================================

# --- MODO: local / local-cloud (XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_tecnocel_v4

# --- MODO: aiven — comentar bloque anterior y descomentar este ---
# DB_HOST=tu_host.aivencloud.com
# DB_PORT=24334
# DB_USER=avnadmin
# DB_PASSWORD=tu_password_aiven
# DB_NAME=db_tecnocel_v4
# DB_SSL=true
# DB_SSL_CA_PATH=./ca-certificate.pem
# Alternativa sin archivo PEM: DB_SSL_CA_CERT=-----BEGIN CERTIFICATE-----...


# ============================================================
# [CAMBIAR 2/2] IMÁGENES
# ============================================================

# local → false | local-cloud → true | aiven → true
USE_CLOUDINARY=false


# ============================================================
# SERVIDOR
# ============================================================
PORT=3000
NODE_ENV=development


# ============================================================
# JWT
# ============================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=clave_secreta_supersegura_cambiar_en_produccion
JWT_ADMIN_SECRET=otra_clave_secreta_supersegura_para_admin


# ============================================================
# LOGGING
# ============================================================
# Niveles: error, warn, info, debug
LOG_LEVEL=info
# true = muestra queries SQL en consola
SEQUELIZE_DEBUG=false


# ============================================================
# IMÁGENES LOCALES (activas cuando USE_CLOUDINARY=false)
# ============================================================
# Ajustar rutas según tu sistema operativo
# Windows: C:\ruta\a\tecnocel_web\backend\uploads
# macOS/Linux: /home/usuario/tecnocel_web/backend/uploads
IMAGES_BASE_PATH=C:\ruta\a\tecnocel_web\backend\uploads
PRODUCT_IMAGES_PATH=C:\ruta\a\tecnocel_web\backend\uploads\productos
COMMENT_IMAGES_PATH=C:\ruta\a\tecnocel_web\backend\uploads\comentarios
MARCA_IMAGES_PATH=C:\ruta\a\tecnocel_web\backend\uploads\marcas
BASE_URL=http://localhost
IMAGES_ENDPOINT=
DEFAULT_PRODUCT_IMAGE=default-product.png
DEFAULT_COMMENT_IMAGE=default-comment.png
DEFAULT_MARCA_IMAGE=default-marca.png


# ============================================================
# CLOUDINARY (activas cuando USE_CLOUDINARY=true)
# ============================================================
# Crear cuenta en cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_PRODUCT_FOLDER=tecnocel/productos
CLOUDINARY_COMMENT_FOLDER=tecnocel/comentarios
CLOUDINARY_MARCA_FOLDER=tecnocel/marcas


# ============================================================
# EMAIL (Resend — https://resend.com)
# ============================================================
# API Keys → Create API Key
# Para pruebas usar EMAIL_FROM=onboarding@resend.dev (solo envía a tu email verificado)
# Para producción verificar tu dominio en Resend → Domains
#
# EMAIL_ENABLED controla el servicio de envío:
#   true  = se envían emails (requiere API key y remitente configurados)
#   false = modo demo sin email: se omiten todos los envíos y el registro
#           de clientes crea las cuentas ya verificadas y activas
EMAIL_ENABLED=true
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=TecnoCel <onboarding@resend.dev>


# ============================================================
# FRONTEND
# ============================================================
FRONTEND_URL=http://localhost:5173


# ============================================================
# GOOGLE OAUTH
# ============================================================
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret
