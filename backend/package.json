{
  "name": "tecnocel-web-backend",
  "version": "1.0.0",
  "description": "Backend para la tienda en línea TecnoCel Web",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/templates', 'dist/templates', {recursive: true})\"",
    "build:swagger": "node scripts/swagger-jsdoc.mjs",
    "swagger": "node scripts/swagger-jsdoc.mjs",
    "start": "node dist/index.js",
    "dev": "concurrently \"tsc --watch\" \"nodemon\"",
    "sync:cloudinary": "node --loader ts-node/esm scripts/migrations/syncToCloudinary.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/pdfkit": "^0.17.5",
    "@types/sharp": "^0.31.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.18.0",
    "resend": "^6.9.3",
    "sequelize": "^6.35.2",
    "sharp": "^0.34.3",
    "swagger-autogen": "^2.23.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.3.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "axios": "^1.11.0",
    "concurrently": "^9.1.2",
    "form-data": "^4.0.4",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
}
