{
  "name": "tecnocel-web-backend",
  "version": "1.0.0",
  "description": "Backend para la tienda en línea TecnoCel Web",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"tsc --watch\" \"nodemon\"",
    "dev:local": "node switch-env.js local && npm run dev",
    "dev:aiven": "node switch-env.js aiven && npm run dev",
    "switch:local": "node switch-env.js local",
    "switch:aiven": "node switch-env.js aiven",
    "test:images": "node scripts_test/test-image-endpoints.js",
    "init:logs": "node scripts_test/init-logs-structure.js",
    "migrate:cloudinary": "node --loader ts-node/esm scripts/migrations/migrateToCloudinary.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/sharp": "^0.31.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sequelize": "^6.35.2",
    "sharp": "^0.34.3",
    "typescript": "^5.3.3",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "concurrently": "^9.1.2",
    "form-data": "^4.0.4",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2"
  }
}
