# ========================================
# VARIABLES DE ENTORNO PARA EL FRONTEND
# ========================================
# Copia este archivo como .env y configura los valores según tu entorno

# URL base de la API del backend
# En desarrollo: http://localhost:3000/api
# En producción: https://tu-dominio.com/api
VITE_API_URL=http://localhost:3000/api

# ID de cliente de Google OAuth
# Obtén este valor desde Google Cloud Console
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=tu-google-client-id-aqui

# ========================================
# NOTAS IMPORTANTES:
# ========================================
# - Todas las variables de entorno en Vite deben empezar con VITE_
# - No incluyas VITE_CORS_ORIGIN aquí (se configura en el backend)
# - No incluyas secretos del cliente aquí (van en el backend)
# - Este archivo NO debe contener valores reales de producción
# ======================================== 