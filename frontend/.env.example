# ========================================
# VARIABLES DE ENTORNO PARA EL FRONTEND
# ========================================
# Copia este archivo como .env y configura los valores según tu entorno

# URL base de la API del backend
# En desarrollo: http://localhost:3000/api
# En producción: https://tu-dominio.com/api
VITE_API_URL=http://localhost:3000/api

# ID de cliente de Google OAuth
# Obtén este valor desde Google Cloud Console
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ========================================
# CONFIGURACIÓN DE CACHE DE FAVORITOS
# ========================================
# Duración del cache de favoritos en milisegundos (2 minutos por defecto)
VITE_FAVORITOS_CACHE_DURATION=120000

# Clave para almacenar el cache de favoritos en localStorage
VITE_FAVORITOS_CACHE_KEY=favoritos_cache

# ========================================
# CONFIGURACIÓN DE CACHE DE OFERTAS
# ========================================
# Duración del cache de ofertas en milisegundos (2 minutos por defecto)
VITE_OFERTAS_CACHE_DURATION=120000

# Clave para almacenar el cache de ofertas en localStorage
VITE_OFERTAS_CACHE_KEY=ofertas_cache

# Intervalo de refresco automático en milisegundos (1 minuto por defecto)
VITE_OFERTAS_REFRESH_INTERVAL=60000

# ========================================
# CONFIGURACIÓN DE CACHE DE PRODUCTOS
# ========================================
# Duración del cache de productos en milisegundos (3 minutos por defecto)
VITE_PRODUCTS_CACHE_DURATION=180000

# Duración del cache de imágenes en milisegundos (30 minutos por defecto)
VITE_IMAGES_CACHE_DURATION=1800000

# Clave para almacenar el cache de productos en localStorage
VITE_PRODUCT_CACHE_KEY=tecnocel_product_cache

# Clave para almacenar el cache de imágenes en localStorage
VITE_IMAGE_CACHE_KEY=tecnocel_image_cache

# ========================================
# NOTAS IMPORTANTES:
# ========================================
# - Todas las variables de entorno en Vite deben empezar con VITE_
# - No incluyas VITE_CORS_ORIGIN aquí (se configura en el backend)
# - No incluyas secretos del cliente aquí (van en el backend)
# - Este archivo NO debe contener valores reales de producción
# ========================================
